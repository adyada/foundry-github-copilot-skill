# Environment Configuration for Microsoft Foundry Agent Integration

# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with actual credentials to source control

# Required: Your Microsoft Foundry project endpoint
# Format: https://{resource}.services.ai.azure.com
# Example: https://my-foundry.services.ai.azure.com
# You can find this in the Azure AI Foundry portal under your project settings
AZURE_AI_PROJECT_ENDPOINT=

# Required: The ID of your agent
# This is the unique identifier for your agent (not the deployment name)
# You can find this in the Foundry portal under Agents
AZURE_AGENT_ID=

# Optional: Azure authentication (if not using DefaultAzureCredential)
# Uncomment and set these if you want to use service principal authentication

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional: API Key authentication (alternative to Azure AD)
# Only use this for development/testing, not recommended for production

# AZURE_AI_API_KEY=

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
